---
import type { Dict } from '../i18n';

interface Props { dict: Dict; }
const { dict } = Astro.props;
---

<section class="max-w-3xl mx-auto px-4 pt-14 pb-10 text-center">
  <h1 class="text-4xl md:text-[40px] font-bold tracking-tight leading-tight">{dict.hero.title}</h1>
  <p class="mt-4 text-lg" style="color: var(--text-2);">{dict.hero.sub}</p>
</section>
